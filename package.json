{
  "name": "commitscribe",
  "displayName": "CommitScribe",
  "publisher": "AayushChopra",
  "description": "Introduces a commit message generator built on a Retrieval-Augmented Generation (RAG) workflow with Gemini AI. Staged diffs are embedded, retrieved, and summarized into structured, Conventional-Commit-style messages.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.105.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushchopra20/commitcraft.git"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitscribe.generateCommit",
        "title": "commitscribe: Generate Commit Message"
      }
    ],
    "keybindings": [
      {
        "command": "commitscribe.generateCommit",
        "key": "ctrl+alt+g",
        "when": "scmFocus"
      }
    ],
    "configuration": {
      "title": "CommitScribe",
      "properties": {
        "commitscribe.geminiApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Google AI studio. Leave empty to use environment variable GEMINI_API_KEY."
        },
        "commitscribe.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "markdownDescription": "Gemini Model name for generating commit messages."
        },
        "commitscribe.maxChars": {
          "type": "number",
          "default": 72,
          "markdownDescription": "Max characters for the subject line."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.3",
    "openai": "^6.9.0"
  }
}
